# SQLite for local development. Swap provider + URL for Postgres in production.
DATABASE_URL="file:./dev.db"

# Base URL used for payment redirects.
APP_URL="http://localhost:3000"

# 32-byte key (64 hex chars) used to encrypt child photos & illustrations at rest.
# Generate with: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=""

# Optional: Claude personalises story text within the template guardrails.
# Without it, stories are rendered deterministically from the template.
ANTHROPIC_API_KEY=""

# Optional: Stripe. Without it, a local mock checkout is used (dev only).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Only for staging demos: allow the mock checkout in a production build.
ALLOW_MOCK_PAYMENTS="false"
